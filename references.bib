@article{altafModellingInternationalTourist2021,
  title = {Modelling the {{International Tourist Arrivals}} in {{India}}},
  author = {Altaf, Nufazil},
  year = {2021},
  journal = {Tourism Planning \& Development},
  volume = {18},
  number = {6},
  pages = {699--708},
  publisher = {{Routledge}},
  abstract = {Using the gravity model, this article investigates the determinants of tourist inflow to India. Several origin–destination (O-D) linked factors, such as Gross Domestic Product, Price index, Exchange Rate, Population, Distance, and Exports and Imports between India and its tourist origins, are explored. Using the panel dataset of 19 tourist originating countries to India from 2000 to 2018 the results of the study suggest that all the variables of the gravity model have statistically significant effects on tourist arrivals to India. In addition, we find tourism inflow to be highly price elastic. Additionally, we found a significant positive relationship between political stability and import ratio variable with tourism arrival. However, we found a significant negative relationship of export ratio with tourism arrival. The study findings provide initial ques to the policy makers and tourism industry players for developing strategies, policies, and regulations in line with increasing the inbound tourist flow to India.},
  keywords = {gravity model,India,India’s international tourism,panel data,Tourism demand},
  annotation = {\_eprint: https://doi.org/10.1080/21568316.2021.1887346}
}

@article{alvarez-diazAnalysingDomesticTourism2020,
  title = {Analysing Domestic Tourism Flows at the Provincial Level in {{Spain}} by Using Spatial Gravity Models},
  author = {Alvarez-Diaz, Marcos and D'Hombres, Beatrice and Ghisetti, Claudia and Pontarollo, Nicola},
  year = {2020},
  journal = {International Journal of Tourism Research},
  volume = {22},
  number = {4},
  pages = {403--415},
  abstract = {Domestic tourism represents a large share of the total tourism volume in Spain, but it is still an under-researched topic. This study focuses on the determinants of domestic flows in Spain at provincial level. The prior assumption is that domestic tourism demand may be affected by specific local conditions that previous studies, mostly based on more aggregate data, would hardly capture. A gravity model and various spatial econometric models are estimated assuming alternative spatial weighting matrices. Results suggest that income and relative prices affect tourism demand in Spanish provinces as well as weather, natural amenities, infrastructures, and recreational activities.},
  langid = {english},
  keywords = {domestic tourism,elasticities,NUTS-3,Spain,spatial econometrics},
  annotation = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/jtr.2344},
  file = {/Users/tomba/Dropbox/org/references/papers/storage/BNRBKRZZ/Alvarez-Diaz et al. - 2020 - Analysing domestic tourism flows at the provincial.pdf;/Users/tomba/Dropbox/org/references/papers/storage/YQWDTBPD/jtr.html}
