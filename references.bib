  annotation = {\_eprint: https://doi.org/10.1080/10242690701453917},
  file = {/Users/tomba/Dropbox/org/references/papers/storage/ESM5FXWH/Llorca‐Vivero†_2008_Terrorism and International Tourism.pdf}
